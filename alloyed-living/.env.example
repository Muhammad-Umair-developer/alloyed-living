# Alloyed Living — storefront environment variables.
# Copy to .env and fill in real values. Never commit .env.
#
# R = Required for the app to function correctly.
# O = Optional — has a code fallback or only affects an optional feature.

# ── Supabase (R) ─────────────────────────────────────────────────────────────
# Project URL and publishable anon key. Exposed to the browser (NEXT_PUBLIC_).
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Service-role key. Server-only — bypasses RLS. NEVER prefix with NEXT_PUBLIC_,
# never expose to the browser. Used for order writes, payment verification
# reads, analytics, and receipt storage.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ── Email (Resend) (R for order/contact emails) ─────────────────────────────
# API key for sending order-placed, receipt-received, and contact-form emails.
RESEND_API_KEY=re_your_resend_api_key

# "From" address for customer-facing order emails. Must be on a domain
# verified in your Resend account. Falls back to a resend.dev address that
# only delivers to your own Resend account email (O).
EMAIL_FROM=Alloyed Living <no-reply@yourdomain.com>

# ── Contact form (R) ─────────────────────────────────────────────────────────
# Inbox that receives contact-form submissions.
CONTACT_FORM_TO_EMAIL=hello@yourdomain.com

# ── Owner order notifications (O) ───────────────────────────────────────────
# Inbox that receives "new order" alerts. Falls back to CONTACT_FORM_TO_EMAIL,
# then a built-in default, if unset.
ORDER_NOTIFICATION_EMAIL=orders@yourdomain.com
# "From" address for owner notification emails specifically (O).
ORDER_NOTIFICATION_FROM=Alloyed Living <orders@yourdomain.com>

# ── Site URL (O) ─────────────────────────────────────────────────────────────
# Absolute public URL of this storefront, used to build links in emails
# (e.g. the checkout confirmation-page link). Falls back to the incoming
# request's Host header if unset — set explicitly for tunnels/local dev where
# that header isn't reliable.
NEXT_PUBLIC_SITE_URL=https://www.yourdomain.com

# ── Cross-app content revalidation (O) ──────────────────────────────────────
# Shared secret the dashboard calls this app with after a content edit, so the
# relevant storefront page can be revalidated on demand.
REVALIDATE_SECRET=a-long-random-shared-secret
