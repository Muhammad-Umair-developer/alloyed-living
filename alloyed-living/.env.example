NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only (NO NEXT_PUBLIC_ prefix). Used by the storefront's admin client for
# trusted writes: order creation, the Safepay webhook payment update, and analytics.
SUPABASE_SERVICE_ROLE_KEY=

# Contact form + order confirmation email delivery (Resend) — server-side only,
# never exposed to the client.
RESEND_API_KEY=
CONTACT_FORM_TO_EMAIL=
# Owner inbox that receives a "new order" notification when a customer places an
# order (COD immediately; Safepay once payment is confirmed). Optional — falls
# back to CONTACT_FORM_TO_EMAIL, then to the built-in default
# (orders@alloyedliving.com) when unset.
ORDER_NOTIFICATION_EMAIL=
# "from" address for the owner new-order alert (defaults to
# "Alloyed Living <orders@alloyedliving.com>"). Must be on a domain verified in
# Resend. Separate from EMAIL_FROM so alerts come from orders@ while the
# customer confirmation keeps using the no-reply@ sender.
ORDER_NOTIFICATION_FROM=
# "from" address for order confirmation emails (COD + Safepay). Must be on a
# domain verified in Resend > Domains, e.g. "Alloyed Living <no-reply@yourdomain.com>".
# The onboarding@resend.dev fallback only delivers to your own Resend account email.
EMAIL_FROM=

# ─── Safepay (Advanced Checkout) ──────────────────────────────────────────────
# Sandbox uses host https://sandbox.api.getsafepay.com and your sandbox test keys.
# Server-only secrets (NO NEXT_PUBLIC_ prefix — never inlined into the browser):
SAFEPAY_ENVIRONMENT=sandbox
SAFEPAY_API_KEY=
SAFEPAY_SECRET=
SAFEPAY_WEBHOOK_SECRET=
# Public URL Safepay's servers use to reach the webhook (e.g. an ngrok tunnel in
# local dev). Falls back to NEXT_PUBLIC_SITE_URL / the request host if unset.
SAFEPAY_PUBLIC_URL=

# ─── Cross-app revalidation ────────────────────────────────────────────────────
# Shared secret the dashboard app (a separate deployment) sends to POST
# /api/revalidate on this app after a product/content edit, so the change
# appears immediately instead of waiting on this page's ISR window. Must match
# REVALIDATE_SECRET in the dashboard's env.
REVALIDATE_SECRET=
