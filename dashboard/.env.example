# Alloyed Living — admin dashboard environment variables.
# Copy to .env and fill in real values. Never commit .env.
#
# R = Required for the app to function correctly.
# O = Optional — has a code fallback or only affects an optional feature.

# ── Supabase (R) ─────────────────────────────────────────────────────────────
# Same Supabase project as the storefront.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Service-role key. Server-only — bypasses RLS. NEVER prefix with NEXT_PUBLIC_,
# never expose to the browser. Used for all admin reads/writes: products,
# orders, payment verification, admin invites, and receipt signed URLs.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ── Email (Resend) (O — required only for payment-verification emails) ─────
# Needed for the two order-payment emails this app sends: the "payment
# confirmed" email on Confirm Order, and the "action needed" email on Reject.
# Without it, both actions still succeed; only the email silently fails
# (logged server-side).
RESEND_API_KEY=re_your_resend_api_key

# "From" address for the emails above. Must be on a domain verified in your
# Resend account. Falls back to a resend.dev address that only delivers to
# your own Resend account email (O).
EMAIL_FROM=Alloyed Living <no-reply@yourdomain.com>

# ── Storefront linkage (R) ───────────────────────────────────────────────────
# Absolute URL of the alloyed-living storefront. Used to build the re-upload
# link in the payment-rejection email, and to trigger on-demand revalidation
# after content edits.
STOREFRONT_URL=https://www.yourdomain.com

# Public-facing storefront URL shown in the dashboard UI (e.g. a "View site"
# link). May be the same as STOREFRONT_URL.
NEXT_PUBLIC_STOREFRONT_URL=https://www.yourdomain.com

# Shared secret sent to the storefront's /api/revalidate route after a content
# edit here, so the matching page can be revalidated on demand. Must match
# REVALIDATE_SECRET in alloyed-living/.env.
STOREFRONT_REVALIDATE_SECRET=a-long-random-shared-secret
