NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Storefront (separate Vercel app) — called after product/content edits so
# changes appear immediately instead of waiting on the storefront's ISR window.
# STOREFRONT_REVALIDATE_SECRET must match REVALIDATE_SECRET in alloyed-living's env.
STOREFRONT_URL=
STOREFRONT_REVALIDATE_SECRET=

# ─────────────────────────────────────────────────────────────────────────────
# Supabase "Send Email" Auth Hook (Edge Function: supabase/functions/send-email-hook)
# These are NOT Next.js env vars. They are Edge Function secrets, set via the
# Supabase CLI (`supabase secrets set ...`), and are listed here for reference only.
#   RESEND_API_KEY          — Resend API key the hook uses to send auth emails
#   SEND_EMAIL_HOOK_SECRET  — hook signing secret from the dashboard ("v1,whsec_...")
# ─────────────────────────────────────────────────────────────────────────────
RESEND_API_KEY=
SEND_EMAIL_HOOK_SECRET=
